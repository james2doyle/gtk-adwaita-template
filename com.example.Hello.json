{
    "id" : "com.example.Hello",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "hello",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "hello",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [
                        ".git",
                        ".gitignore",
                        "build",
                        "build-install",
                        "build-flatpak",
                        ".flatpak-builder",
                        ".venv",
                        ".dex",
                        "__pycache__",
                        "*.pyc",
                        "dist",
                        "subprojects/blueprint-compiler"
                    ]
                }
            ],
            "config-opts" : [
                "--libdir=lib"
            ]
        }
    ]
}
